<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- App Bar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:title="Drive Safe App"
        android:titleTextColor="#fff"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:navigationIcon="@drawable/ic_launcher_foreground"
        android:background="#34253a" />

    <!-- Speedometer -->
    <me.ibrahimsn.lib.Speedometer
        android:id="@+id/speedometer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="30dp"
        android:layout_marginHorizontal="20dp"
        app:maxSpeed="200"
        app:borderSize="8dp"
        app:metricText="km/h"
        app:borderColor="#402c47"
        app:fillColor="#d83a78"
        android:layout_marginTop="32dp" />

    <!-- Connect OBD Button -->
    <Button
        android:id="@+id/connect_obd_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Connect OBD"
        android:textColor="#FFFFFF"
        android:background="@drawable/button_background"
        android:layout_gravity="center" />

    <!-- Start Simulation Button -->
    <Button
        android:id="@+id/start_simulation_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Start Simulation"
        android:textColor="#FFFFFF"
        android:background="@drawable/button_background"
        android:layout_marginTop="16dp"
        android:layout_gravity="center" />

</LinearLayout>
